# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Slack (Socket Mode: no public URL needed) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- GitHub (so Marty can read and commit the strategy repo) ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=brbernst94/Martin
GITHUB_BRANCH=main
# Where the working copy lives. Mount a Railway volume here to survive restarts.
REPO_DIR=/data/repo

# --- Marty ---
MARTY_MODEL=claude-opus-5
MARTY_EFFORT=high
# Comma-separated Slack user IDs allowed to talk to Marty. Empty = anyone in the
# workspace who can see him. Set this.
MARTY_ALLOWED_USERS=

# --- Morning brief (leave BRIEF_CRON empty to keep it off) ---
BRIEF_CRON=
BRIEF_CHANNEL=
BRIEF_TZ=America/Denver

# --- Railway ---
PORT=8080
